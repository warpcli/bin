{
  "name": "geto",
  "description": "Effortless binary manager",
  "license": "MIT",
  "authors": [
    "Trim Bresilla"
  ],
  "targetType": "executable",
  "targetName": "geto",
  "sourcePaths": [
    "source"
  ],
  "importPaths": [
    "source"
  ],
  "stringImportPaths": [
    "source/geto/ai/seed",
    "."
  ],
  "dependencies": {
    "mochafizz": {
      "repository": "git+https://github.com/bresilla/mochafizz",
      "version": "a5ad7c149bfa7a5f9e98d44e1d79ab625ff6b289"
    },
    "requests": "~>2.2.1",
    "squiz-box": "~>0.3.0"
  },
  "configurations": [
    {
      "name": "application",
      "targetType": "executable",
      "mainSourceFile": "source/app.d"
    },
    {
      "name": "static",
      "targetType": "executable",
      "comment": "Fully static build. Needs musl static archives for openssl, lzma, bzip2 and zstd \u2014 see `make static` and the Alpine release job.",
      "mainSourceFile": "source/app.d",
      "subConfigurations": {
        "requests": "staticssl"
      },
      "dflags": [
        "-static"
      ]
    }
  ],
  "buildTypes": {
    "release": {
      "buildOptions": [
        "releaseMode",
        "optimize",
        "inline"
      ]
    }
  }
}
