# build output
/geto
/geto-test-*
/build/
*.o
*.a
*.lst

# dub. dub.json is the only manifest kept; dub rewrites the selections file on
# every build and nix pins its dependencies by hash instead.
/.dub/

# nix / direnv
/result
/result-*
.direnv/

# editors
.vscode/
.idea/
*.swp

# dub writes this on every build; the manifest is the source of truth
/dub.selections.json

# the checkout-local install target used by .env.lua
/target/
